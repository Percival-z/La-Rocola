# Copia este archivo a .env y rellena los valores.
#   cp .env.example .env      (Linux)
#   copy .env.example .env    (Windows)
# .env está en .gitignore: NUNCA se sube al repo.

# --- Discord (https://discord.com/developers/applications) ---
DS_TOKEN=
DS_APP_ID=
DS_PUBLIC_KEY=

# --- Spotify (https://developer.spotify.com/dashboard) ---
# start.sh / start.bat exportan estas dos a Java: application.yml las lee
# como ${SPOTIFY_CLIENT_ID:} / ${SPOTIFY_CLIENT_SECRET:}.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Lavalink ---
LAVA_LINK_URI=http://127.0.0.1:2333
LAVA_LINK_PASSWORD=botds_lavalink_pw

# --- Auto-union al iniciar (opcional) ---
AUTO_JOIN_GUILD=
AUTO_JOIN_CHANNEL=
